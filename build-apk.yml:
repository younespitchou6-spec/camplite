import 'package:flutter/material.dart';

void main() {
  runApp(const CampLiteApp());
}

class CampLiteApp extends StatelessWidget {
  const CampLiteApp({super.key});

  static const Color pureWhite = Color(0xFFFFFFFF);
  static const Color lightGreen = Color(0xFF4CAF50);
  static const Color paleGreen = Color(0xFFE8F5E9);
  static const Color lightOrange = Color(0xFFFFA726);
  static const Color darkText = Color(0xFF212121);
  static const Color dividerGray = Color(0xFFF2F4F7);

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'CampLite',
      theme: ThemeData(
        scaffoldBackgroundColor: pureWhite,
        primaryColor: lightGreen,
        colorScheme: const ColorScheme.light(
          primary: lightGreen,
          secondary: lightOrange,
          surface: pureWhite,
        ),
        splashFactory: NoSplash.splashFactory,
        highlightColor: Colors.transparent,
      ),
      home: const MainLiteScreen(),
    );
  }
}

class GearItem {
  final String id;
  final String title;
  final String price;
  final String category;
  final String city;
  final String condition;

  const GearItem({
    required this.id,
    required this.title,
    required this.price,
    required this.category,
    required this.city,
    required this.condition,
  });
}

class MainLiteScreen extends StatefulWidget {
  const MainLiteScreen({super.key});

  @override
  State<MainLiteScreen> createState() => _MainLiteScreenState();
}

class _MainLiteScreenState extends State<MainLiteScreen> {
  int _currentIndex = 0;

  final List<GearItem> _allGear = const [
    GearItem(id: '1', title: 'خيمة 4 أشخاص مقاومة للرياح', price: '18,500 د.ج', category: 'خيام', city: 'البليدة', condition: 'جديد'),
    GearItem(id: '2', title: 'موقد غاز محمول صغير', price: '4,200 د.ج', category: 'طبخ', city: 'وهران', condition: 'مستعمل'),
    GearItem(id: '3', title: 'حقيبة ظهر 60 لتر للتخييم', price: '9,800 د.ج', category: 'حقائب', city: 'تيزي وزو', condition: 'جديد'),
    GearItem(id: '4', title: 'مصباح LED شحن شمسي', price: '3,100 د.ج', category: 'إنارة', city: 'البليدة', condition: 'جديد'),
    GearItem(id: '5', title: 'كيس نوم شتوي مريح', price: '7,500 د.ج', category: 'خيام', city: 'سطيف', condition: 'مستعمل'),
    GearItem(id: '6', title: 'طقم أواني طبخ ألومنيوم', price: '5,400 د.ج', category: 'طبخ', city: 'وهران', condition: 'جديد'),
  ];

  String _selectedCategory = 'الكل';
  String _selectedCity = 'كل الولايات';

  final List<String> _categories = ['الكل', 'خيام', 'طبخ', 'حقائب', 'إنارة', 'مستعمل'];
  final List<String> _cities = ['كل الولايات', 'البليدة', 'وهران', 'تيزي وزو', 'سطيف'];

  List<GearItem> get _filteredGear {
    return _allGear.where((item) {
      final matchesCategory = _selectedCategory == 'الكل' ||
          item.category == _selectedCategory ||
          (_selectedCategory == 'مستعمل' && item.condition == 'مستعمل');
      final matchesCity = _selectedCity == 'كل الولايات' || item.city == _selectedCity;
      return matchesCategory && matchesCity;
    }).toList();
  }

  @override
  Widget build(BuildContext context) {
    return Directionality(
      textDirection: TextDirection.rtl,
      child: Scaffold(
        appBar: AppBar(
          backgroundColor: CampLiteApp.pureWhite,
          elevation: 0.5,
          title: Text(
            _currentIndex == 1 ? 'متجر العتاد' : 'CampLite',
            style: const TextStyle(
              color: CampLiteApp.lightGreen,
              fontWeight: FontWeight.bold,
              fontSize: 21,
            ),
          ),
          actions: [
            if (_currentIndex == 1) _buildCityFilterDropdown(),
            if (_currentIndex == 0)
              Container(
                margin: const EdgeInsets.symmetric(vertical: 10, horizontal: 8),
                padding: const EdgeInsets.symmetric(horizontal: 10),
                decoration: BoxDecoration(
                  color: CampLiteApp.paleGreen,
                  borderRadius: BorderRadius.circular(12),
                ),
                child: const Center(
                  child: Text(
                    'HD تلقائي',
                    style: TextStyle(color: CampLiteApp.lightGreen, fontSize: 12, fontWeight: FontWeight.bold),
                  ),
                ),
              ),
            IconButton(
              icon: const Icon(Icons.search, color: CampLiteApp.darkText),
              onPressed: () {},
            ),
          ],
        ),
        body: _currentIndex == 1 ? _buildMarketplaceScreen() : _buildFeedScreen(),
        bottomNavigationBar: BottomNavigationBar(
          currentIndex: _currentIndex,
          onTap: (index) {
            if (index == 2) {
              ScaffoldMessenger.of(context).showSnackBar(
                const SnackBar(content: Text('فتح نافذة إضافة منشور أو عرض عتاد للبيع')),
              );
              return;
            }
            setState(() => _currentIndex = index);
          },
          type: BottomNavigationBarType.fixed,
          backgroundColor: CampLiteApp.pureWhite,
          selectedItemColor: CampLiteApp.lightGreen,
          unselectedItemColor: Colors.grey,
          elevation: 2,
          items: [
            const BottomNavigationBarItem(icon: Icon(Icons.explore_outlined), label: 'الرئيسية'),
            const BottomNavigationBarItem(icon: Icon(Icons.storefront_outlined), label: 'المتجر'),
            BottomNavigationBarItem(
              icon: Container(
                padding: const EdgeInsets.all(8),
                decoration: const BoxDecoration(color: CampLiteApp.lightOrange, shape: BoxShape.circle),
                child: const Icon(Icons.add, color: CampLiteApp.pureWhite, size: 22),
              ),
              label: 'نشر',
            ),
            const BottomNavigationBarItem(icon: Icon(Icons.chat_bubble_outline), label: 'الرسائل'),
          ],
        ),
      ),
    );
  }

  Widget _buildFeedScreen() {
    return ListView.separated(
      itemCount: 15,
      separatorBuilder: (_, __) => const Divider(height: 6, thickness: 6, color: CampLiteApp.dividerGray),
      itemBuilder: (context, index) {
        return Container(
          color: CampLiteApp.pureWhite,
          padding: const EdgeInsets.all(12),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Row(
                children: [
                  const CircleAvatar(
                    radius: 18,
                    backgroundColor: CampLiteApp.paleGreen,
                    child: Icon(Icons.person, color: CampLiteApp.lightGreen, size: 20),
                  ),
                  const SizedBox(width: 10),
                  const Expanded(
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Text('أحمد المخيم', style: TextStyle(fontWeight: FontWeight.bold, color: CampLiteApp.darkText)),
                        Text('منذ ساعتين', style: TextStyle(fontSize: 11, color: Colors.grey)),
                      ],
                    ),
                  ),
                  Container(
                    padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                    decoration: BoxDecoration(color: CampLiteApp.paleGreen, borderRadius: BorderRadius.circular(8)),
                    child: const Row(
                      children: [
                        Icon(Icons.location_on, size: 14, color: CampLiteApp.lightGreen),
                        SizedBox(width: 4),
                        Text('جبال الشريعة', style: TextStyle(fontSize: 11, color: CampLiteApp.lightGreen, fontWeight: FontWeight.w600)),
                      ],
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 10),
              const Text(
                'أجواء رائعة فجر اليوم، التغطية ضعيفة لكن المنظر يستحق المشاركة!',
                style: TextStyle(color: CampLiteApp.darkText, fontSize: 14),
              ),
              const SizedBox(height: 10),
              Stack(
                children: [
                  Container(
                    height: 200,
                    width: double.infinity,
                    decoration: BoxDecoration(color: const Color(0xFFEEEEEE), borderRadius: BorderRadius.circular(8)),
                    child: const Center(child: Icon(Icons.landscape, size: 50, color: Colors.grey)),
                  ),
                  Positioned(
                    top: 8,
                    right: 8,
                    child: Container(
                      padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                      decoration: BoxDecoration(color: CampLiteApp.lightOrange, borderRadius: BorderRadius.circular(6)),
                      child: const Text(
                        'HD • اضغط للتكبير',
                        style: TextStyle(color: CampLiteApp.pureWhite, fontSize: 11, fontWeight: FontWeight.bold),
                      ),
                    ),
                  ),
                ],
              ),
            ],
          ),
        );
      },
    );
  }

  Widget _buildCityFilterDropdown() {
    return Container(
      margin: const EdgeInsets.symmetric(vertical: 10, horizontal: 4),
      padding: const EdgeInsets.symmetric(horizontal: 8),
      decoration: BoxDecoration(color: CampLiteApp.paleGreen, borderRadius: BorderRadius.circular(10)),
      child: DropdownButtonHideUnderline(
        child: DropdownButton<String>(
          value: _selectedCity,
          icon: const Icon(Icons.keyboard_arrow_down, color: CampLiteApp.lightGreen, size: 18),
          style: const TextStyle(color: CampLiteApp.lightGreen, fontSize: 12, fontWeight: FontWeight.bold),
          items: _cities.map((city) => DropdownMenuItem(value: city, child: Text(city))).toList(),
          onChanged: (val) {
            if (val != null) setState(() => _selectedCity = val);
          },
        ),
      ),
    );
  }

  Widget _buildMarketplaceScreen() {
    final items = _filteredGear;
    return Column(
      children: [
        SizedBox(
          height: 48,
          child: ListView.separated(
            scrollDirection: Axis.horizontal,
            padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 8),
            itemCount: _categories.length,
            separatorBuilder: (_, __) => const SizedBox(width: 8),
            itemBuilder: (context, index) {
              final cat = _categories[index];
              final isSelected = _selectedCategory == cat;
              return GestureDetector(
                onTap: () => setState(() => _selectedCategory = cat),
                child: Container(
                  padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 4),
                  decoration: BoxDecoration(
                    color: isSelected ? CampLiteApp.lightGreen : CampLiteApp.pureWhite,
                    borderRadius: BorderRadius.circular(16),
                    border: Border.all(color: isSelected ? CampLiteApp.lightGreen : const Color(0xFFE0E0E0)),
                  ),
                  alignment: Alignment.center,
                  child: Text(
                    cat,
                    style: TextStyle(
                      color: isSelected ? CampLiteApp.pureWhite : CampLiteApp.darkText,
                      fontSize: 12,
                      fontWeight: isSelected ? FontWeight.bold : FontWeight.normal,
                    ),
                  ),
                ),
              );
            },
          ),
        ),
        const Divider(height: 1, color: CampLiteApp.dividerGray),
        Expanded(
          child: items.isEmpty
              ? const Center(child: Text('لا توجد معدات مطابقة للفلتر الحالي', style: TextStyle(color: Colors.grey)))
              : GridView.builder(
                  padding: const EdgeInsets.all(8),
                  gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
                    crossAxisCount: 2,
                    crossAxisSpacing: 8,
                    mainAxisSpacing: 8,
                    childAspectRatio: 0.74,
                  ),
                  itemCount: items.length,
                  itemBuilder: (context, index) => _buildGearCard(items[index]),
                ),
        ),
      ],
    );
  }

  Widget _buildGearCard(GearItem item) {
    return Container(
      decoration: BoxDecoration(
        color: CampLiteApp.pureWhite,
        border: Border.all(color: const Color(0xFFEEEEEE)),
        borderRadius: BorderRadius.circular(8),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Expanded(
            child: Stack(
              children: [
                Container(
                  width: double.infinity,
                  decoration: const BoxDecoration(
                    color: CampLiteApp.dividerGray,
                    borderRadius: BorderRadius.vertical(top: Radius.circular(8)),
                  ),
                  child: const Icon(Icons.backpack_outlined, size: 42, color: Colors.grey),
                ),
                Positioned(
                  top: 6,
                  right: 6,
                  child: Container(
                    padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
                    decoration: BoxDecoration(color: CampLiteApp.paleGreen, borderRadius: BorderRadius.circular(4)),
                    child: Text(
                      item.condition,
                      style: const TextStyle(color: CampLiteApp.lightGreen, fontSize: 10, fontWeight: FontWeight.bold),
                    ),
                  ),
                ),
              ],
            ),
          ),
          Padding(
            padding: const EdgeInsets.all(8),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  item.title,
                  maxLines: 2,
                  overflow: TextOverflow.ellipsis,
                  style: const TextStyle(fontSize: 12.5, fontWeight: FontWeight.w600, color: CampLiteApp.darkText),
                ),
                const SizedBox(height: 4),
                Text(
                  item.price,
                  style: const TextStyle(fontSize: 13.5, fontWeight: FontWeight.bold, color: CampLiteApp.lightOrange),
                ),
                const SizedBox(height: 4),
                Row(
                  children: [
                    const Icon(Icons.location_on_outlined, size: 13, color: Colors.grey),
                    const SizedBox(width: 2),
                    Text(item.city, style: const TextStyle(fontSize: 11, color: Colors.grey)),
                  ],
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }
}
